{
  "name": "Cairn",
  "short_name": "Cairn",
  "description": "A clear workspace for notes, docs and databases.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#17191f",
  "theme_color": "#17191f",
  "share_target": {
    "action": "/capture",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "New task", "short_name": "New task", "description": "Quick capture into Cairn", "url": "/capture?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
